{
  "id": "gate",
  "kind": "exchange",
  "name": "Gate",
  "subclasses": ["gateeu"],
  "domains": ["gate.com", "github.com"],
  "sources": [
    {
      "id": "gate-v4",
      "type": "html",
      "url": "https://www.gate.com/docs/developers/apiv4/en/",
      "scope": "REST (all products)",
      "expectBlocked": "Akamai returns 403 Access Denied to datacenter IPs",
      "split": { "heading": "#changelog ~ p:has(> strong:only-child):not(#changelog ~ h1 ~ *)" },
      "date": { "from": "body" },
      "titleFilter": "^v\\d+\\.\\d+\\.\\d+$"
    },
    {
      "id": "gate-ws-spot",
      "type": "html",
      "url": "https://www.gate.com/docs/developers/apiv4/ws/en/",
      "scope": "spot websocket",
      "expectBlocked": "Akamai returns 403 Access Denied to datacenter IPs",
      "split": { "heading": "#changelog ~ p:not(#changelog ~ :is(h1, h2, h3) ~ *)" },
      "date": { "from": "title" },
      "titleFilter": "^\\d{4}[-.]\\d{1,2}[-.]\\d{1,2}$"
    },
    {
