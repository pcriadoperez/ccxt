# Copy to .env (or export in your shell) and fill in. Only TELEGRAM_BOT_TOKEN is required to chat with the bot.
# Keep comments on their own lines: Docker's --env-file treats text after a value as part of the value.
# RADAR_BOT_USERNAME must match your bot's username (it appears in /about and onboarding).

# From @BotFather (/newbot). Without it the bot runs headless and prints alerts to the console.
TELEGRAM_BOT_TOKEN=
RADAR_BOT_USERNAME=ccxt_radar_bot

# AI assistant through OpenRouter (free router by default). Without a key, commands and buttons still work.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# AI messages per user per day (after their first saved alert)
RADAR_AI_DAILY=20
# AI messages before the first saved alert
RADAR_AI_NEW_USER=3
# Hard cap on AI requests per day for the whole bot
RADAR_AI_GLOBAL_DAILY=2000

# Storage: SQLite file, created on first run. Defaults to data/radar.sqlite locally;
# the Docker image uses /data/radar.sqlite (a volume). Only set this to move it.
# RADAR_DB=data/radar.sqlite

# Venues (comma-separated CCXT ids). Defaults: the 10 core venues, plus 5 listing-only venues.
# RADAR_VENUES=binance,bybit,okx,coinbase,kraken,bitget,gate,kucoin,hyperliquid,mexc
# RADAR_LISTING_VENUES=binance,bybit,okx,coinbase,kraken,bitget,gate,kucoin,hyperliquid,mexc,upbit,bithumb,htx,cryptocom,bingx

# Optional project-owned READ-ONLY keys (no trade, no withdraw permission; IP-allowlist them).
# Needed for deposit/withdrawal status on Binance, Bybit, OKX and MEXC.
# BINANCE_APIKEY=  BINANCE_SECRET=
# BYBIT_APIKEY=    BYBIT_SECRET=
# OKX_APIKEY=      OKX_SECRET=      OKX_PASSWORD=
# MEXC_APIKEY=     MEXC_SECRET=

# Optional public channels (add the bot as a channel admin; use @username or the numeric id)
# RADAR_CHANNEL_LISTINGS=@your_listings_channel
# RADAR_CHANNEL_MOVERS=
# RADAR_CHANNEL_FUNDING=
# RADAR_CHANNEL_STATUS=
# RADAR_CHANNEL_BRIEF=

# Polling intervals in ms (defaults shown)
# RADAR_TICKERS_MS=10000
# RADAR_FUNDING_MS=60000
# RADAR_OI_MS=60000
# RADAR_CURRENCIES_MS=300000
# RADAR_MARKETS_CORE_MS=90000
