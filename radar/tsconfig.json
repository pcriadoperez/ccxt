{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "js",
        "rootDir": "ts",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "lib": ["ES2022", "DOM"]
    },
    "include": ["ts/**/*.ts"],
    "exclude": ["node_modules", "js", "test"]
}
