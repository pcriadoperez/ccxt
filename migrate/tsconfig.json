{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "outDir": "js",
        "rootDir": "ts",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "sourceMap": false,
        "types": ["node"]
    },
    "include": ["ts/*.ts"],
    "exclude": ["node_modules", "js", "../ts"]
}
